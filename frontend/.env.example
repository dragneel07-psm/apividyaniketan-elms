# API URL:
# - Single-domain mode (recommended): /api
# - Direct backend mode: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=/api

# Backend proxy target for Next.js /api route (server-side only)
BACKEND_API_ORIGIN=https://your-railway-backend.up.railway.app

# WebSocket host (browser-side). REQUIRED in production when the frontend is
# served from a host that does not proxy WebSocket upgrades (e.g. Vercel).
# Set to the backend's public hostname (no protocol, no path), e.g.
#   NEXT_PUBLIC_WS_HOST=your-railway-backend.up.railway.app
# Defaults to window.location.host, which only works when the same host serves
# both HTTP and WS (e.g. local dev, single-server deploys).
NEXT_PUBLIC_WS_HOST=your-railway-backend.up.railway.app

# Site URL (For SEO and links)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Default tenant slug used whenever the host isn't an explicitly recognized
# other tenant or configured public/marketing host (bare localhost, the
# platform's managed Railway/Vercel host, bare custom domains). Defaults to
# "apividyaniketan" in code, so this only needs setting to rename/override it.
# NEXT_PUBLIC_DEFAULT_TENANT_SLUG=apividyaniketan

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Cookie domain for cross-subdomain auth (e.g. yourdomain.com clears cookies on school1.yourdomain.com)
# Leave empty for single-domain deployments
NEXT_PUBLIC_COOKIE_DOMAIN=yourdomain.com

# ImageKit CDN — media (school logo, notices, lesson materials, site content
# images, project attachments) is served from here. Public/non-secret; must
# match the backend's IMAGEKIT_URL_ENDPOINT.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Sentry error monitoring (Optional but recommended for production)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=elms-frontend
SENTRY_AUTH_TOKEN=sntrys_xxx
